# Copie este arquivo para ".env" (mesma pasta do pom.xml) e ajuste.
#   PowerShell:  Copy-Item .env.example .env
# O ".env" NUNCA vai para o Git (está no .gitignore).
# Alternativa sem arquivo: $env:DB_SENHA = "sua_senha"  (vale só na janela do PowerShell).

# Usuário do MySQL (padrão: root)
DB_USUARIO=root
# Senha do MySQL da SUA máquina. No XAMPP o root vem SEM senha: deixe vazio.
DB_SENHA=
