# Copie para .env (que NÃO vai para o Git) e ajuste os valores:  cp .env.example .env

# Porta HTTP da API
PORT=3000

# String de conexão MySQL: mysql://USUARIO:SENHA@HOST:PORTA/BANCO
# Se a senha tiver caracteres especiais, codifique-os (ex.: @ vira %40, # vira %23).
# O banco é criado automaticamente na primeira inicialização, se não existir.
DATABASE_URL=mysql://usuario:senha@localhost:3306/cristal_master

NODE_ENV=development
